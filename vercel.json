{
  "services": {
    "dashboard": {
      "root": ".",
      "framework": "tanstack-start-lovable",
      "buildCommand": "npm ci --prefix apps/homey-admin --no-audit --no-fund && npm run build:homey-admin && VITE_ORDERS_MANAGER_URL=/orders-manager npm run build"
    },
    "orders-manager": {
      "root": "apps/orders-manager",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/orders-manager/:path*",
      "destination": {
        "service": "orders-manager"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "dashboard"
      }
    }
  ],
  "headers": [
    {
      "source": "/homey-admin/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
